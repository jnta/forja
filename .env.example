# OpenCode server (start with: opencode serve)
# Run it from this repo so the forja-orchestrator / forja-engineer agents load.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Workspace engineers read/write and run bash in. Defaults to the server project.
OPENCODE_WORKSPACE=

# Optional model overrides (provider/model-id), e.g. opencode/gpt-5-codex
OPENCODE_ORCHESTRATOR_MODEL=
OPENCODE_ENGINEER_MODEL=
